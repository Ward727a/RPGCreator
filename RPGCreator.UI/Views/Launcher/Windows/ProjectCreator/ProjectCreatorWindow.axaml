<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RPGCreator.UI.Views.Launcher"
        xmlns:vm="clr-namespace:RPGCreator.UI.ViewModels.Launcher.ViewModels"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
        x:Class="RPGCreator.Windows.Launcher.ProjectCreator"
        Title="ProjectCreator"
		Width="700"
		Height="500"
		CanResize="False"
		WindowStartupLocation="CenterOwner">
	<views:ProjectCreatorView/>
</Window>
