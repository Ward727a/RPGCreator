
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#

/reference:..\bin\Debug\net8.0\MonoGame.Extended.Content.Pipeline.dll
/reference:..\..\MGCBExtension_RPGCreator\bin\Debug\net8.0\MGCBExtension_RPGCreator.dll

#---------------------------------- Content ---------------------------------#

#begin BaseContent/.gitignore.txt
/importer:TXTImporter
/processor:TXTProcessor
/processorParam:Identifier=RPGCreator.core.io.ContentReader.TextReader, RPGCreator
/build:BaseContent/.gitignore.txt

#begin Fonts/OpenSans-Regular_0.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:ColorKeyColor=255,0,255,255
/processorParam:ColorKeyEnabled=True
/processorParam:GenerateMipmaps=False
/processorParam:PremultiplyAlpha=True
/processorParam:ResizeToPowerOfTwo=False
/processorParam:MakeSquare=False
/processorParam:TextureFormat=Color
/build:Fonts/OpenSans-Regular_0.png

#begin Fonts/OpenSans-Regular.fnt
/importer:BitmapFontImporter
/processor:BitmapFontProcessor
/build:Fonts/OpenSans-Regular.fnt

#begin Fonts/Roboto-Regular.ttf
/copy:Fonts/Roboto-Regular.ttf

#begin Internals/XSD/Configs/plugins.xsd
/copy:Internals/XSD/Configs/plugins.xsd

#begin Internals/XSD/Developers/plugin.xsd
/copy:Internals/XSD/Developers/plugin.xsd

